# =============================================================================
# Bullish 4ex — environment variables
# Copy this file to `.env.local` and fill in your own values.
# Never commit real keys. `.env.local` is already git-ignored.
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND (this Vite / TanStack project)
# Only variables starting with VITE_ are exposed to the browser.
# -----------------------------------------------------------------------------

# Deposit wallets shown on checkout for manual "Crypto QR" payments.
# Leave empty to hide an address (checkout shows "Wallet not configured").
VITE_WALLET_USDT_TRC20=
VITE_WALLET_USDT_BEP20=
VITE_WALLET_USDT_ERC20=
VITE_WALLET_USDT_POLYGON=
VITE_WALLET_BTC=
VITE_WALLET_SOL=

# The frontend calls /api/* on the same origin. In development Vite proxies
# /api to http://localhost:3000 (see vite.config.ts), so run the backend there.


# -----------------------------------------------------------------------------
# BACKEND (prop-firm Next.js API — server only, never expose to the browser)
# These belong in the backend app's own .env.local.
# -----------------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used in emails, redirects and payment return URLs
NEXT_PUBLIC_APP_URL=https://bullish4ex.com
SUPPORT_EMAIL=support@bullish4ex.com

# CRM admin signup passcode — CHANGE THIS (default is ADMIN123 if unset)
CRM_ADMIN_PASSCODE=

# Email (any SMTP server)
HOSTINGER_SMTP_HOST=
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=
HOSTINGER_SMTP_PASS=
HOSTINGER_EMAIL_FROM="Bullish 4ex <no-reply@bullish4ex.com>"

# Account statistics feed (optional)
STATISTICS_API_BASE_URL=https://www.showmytrades.com/api/statistics

# KYC — Didit (optional; runs in simulation mode when empty)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=

# Payments — fill only the gateways you use
# Paddle (card / Apple Pay)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_CHECKOUT_URL=
PADDLE_TWO_STEP_PRICE_ID=
PADDLE_ONE_STEP_PRICE_ID=
PADDLE_INSTANT_PRICE_ID=

# Stripe (requires a live key: sk_live_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# NOWPayments (crypto invoices)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# CodaPay (local payment methods)
CODAPAY_API_KEY=
CODAPAY_PROJECT_ID=
CODAPAY_ENVIRONMENT=sandbox

# Backend copy of the manual crypto wallets (keep in sync with VITE_WALLET_* above).
# If unset, the backend falls back to someone else's wallets — always set these!
NEXT_PUBLIC_WALLET_USDT_TRC20=
NEXT_PUBLIC_WALLET_USDT_BEP20=
NEXT_PUBLIC_WALLET_USDT_ERC20=
NEXT_PUBLIC_WALLET_USDT_POLYGON=
NEXT_PUBLIC_WALLET_BTC=
NEXT_PUBLIC_WALLET_SOL=

# Meta Pixel / Conversions API (optional)
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=

# Weekend holding rule — market close hour in UTC (optional, default 23)
WEEKEND_MARKET_CLOSE_UTC_HOUR=23
